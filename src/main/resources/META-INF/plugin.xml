<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.kotea.companion</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>KoTEA companion</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/Mexator/KoTEA-companion-plugin">KoTEA Team</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <b>KoTEA Companion</b> is an Android Studio plugin designed to improve Developer Experience in projects using the KoTEA architectural pattern.<br><br>
        The plugin simplifies navigation by creating a contextual bridge between the points of generation (Emission) and execution (Processing) of Events and Commands.
        <ul>
            <li><b>Go to emission:</b> Instantly jump to where an event or command is dispatched.</li>
            <li><b>Go to processing:</b> Navigate to the Update class or CommandsFlowHandler where the logic is handled.</li>
            <li><b>Interactive Gutter Icons:</b> Quick navigation markers in the editor gutter for declarations, call sites, and handlers.</li>
        </ul>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->

    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.android</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="com.kotea.companion.commands.CommandMarkerProvider"/>
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="com.kotea.companion.events.EventMarkerProvider"/>
    </extensions>

    <actions>
        <group id = "KoTEA.Navigation" text = "KoTEA Navigation" popup="true" icon="AllIcons.Actions.Search">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <action id="Emission"
                    class="com.kotea.companion.actions.GoToEmissionAction"
                    text="Go to Emission">
                <keyboard-shortcut first-keystroke="control alt M" keymap="$default"/>
            </action>

            <action id="Processing"
                    class="com.kotea.companion.actions.GoToProcessingAction"
                    text="Go to Processing">
                <keyboard-shortcut first-keystroke="control alt K" keymap="$default"/>
            </action>
        </group>
    </actions>
</idea-plugin>
